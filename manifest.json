{
  "manifest_version": 3,
  "name": "CodeBuddy AI",
  "version": "1.0",
  "description": "AI learning coach for DSA learners.",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}